      "strict": false,
      "language": "sql",
      "parallel": "u",
      "leakproof": false,
      "signature": "crm_security.actor()",
      "definition": "CREATE OR REPLACE FUNCTION crm_security.actor()\n RETURNS TABLE(user_id uuid, auth_uid uuid, display_name text, permission_role text)\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n SELECT u.user_id,u.auth_uid,u.name,r.permission_role\n FROM public.users u JOIN crm_security.access_review r ON r.user_id=u.user_id\n WHERE auth.uid() IS NOT NULL AND u.auth_uid=auth.uid() AND u.active AND r.approved\n AND r.reviewed_auth_uid=u.auth_uid AND r.source_role=u.role AND r.expires_at>now()\n AND (SELECT count(*) FROM public.users x WHERE x.auth_uid=u.auth_uid)=1\n$function$\n",
      "volatility": "s",
      "security_definer": true
    },
    {
      "acl": [
        "postgres=X/postgres"
      ],
      "owner": "postgres",
      "config": [
        "search_path=\"\""
      ],
      "strict": false,
      "language": "sql",
      "parallel": "u",
      "leakproof": false,
      "signature": "crm_security.business_can_write(text,uuid)",
      "definition": "CREATE OR REPLACE FUNCTION crm_security.business_can_write(k text, target uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n SELECT CASE WHEN k='deal' THEN crm_security.can_deal(target,true) WHEN k='inquiry' THEN EXISTS(\n SELECT 1 FROM crm_security.actor() a JOIN public.inquiries i ON i.id=target WHERE\n (a.permission_role IN('rep','consultation') AND i.assigned_to=a.user_id) OR\n (a.permission_role IN('branch','admin') AND EXISTS(SELECT 1 FROM crm_security.object_scope s WHERE s.user_id=a.user_id AND s.inquiry_id=target AND s.can_write AND s.expires_at>now()))) ELSE false END\n$function$\n",
      "volatility": "s",
      "security_definer": true
    },
    {
      "acl": [
        "postgres=X/postgres"
      ],
      "owner": "postgres",
      "config": [
        "search_path=\"\""
      ],
      "strict": false,
      "language": "plpgsql",
      "parallel": "u",
      "leakproof": false,
      "signature": "crm_security.business_lock(text,uuid,text)",
      "definition": "CREATE OR REPLACE FUNCTION crm_security.business_lock(k text, target uuid, token text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nDECLARE r jsonb; BEGIN\n IF auth.uid() IS NULL THEN RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;\n PERFORM 1 FROM public.users WHERE auth_uid=auth.uid() FOR SHARE;\n PERFORM 1 FROM crm_security.access_review WHERE reviewed_auth_uid=auth.uid() FOR SHARE;\n PERFORM 1 FROM crm_security.object_scope s JOIN crm_security.actor() a ON a.user_id=s.user_id WHERE s.deal_id=target OR s.inquiry_id=target FOR SHARE OF s;\n IF NOT crm_security.business_can_write(k,target) THEN RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;\n IF k='deal' THEN SELECT to_jsonb(d) INTO r FROM public.deals d WHERE id=target FOR UPDATE;\n ELSE SELECT to_jsonb(i) INTO r FROM public.inquiries i WHERE id=target FOR UPDATE; END IF;\n IF r IS NULL OR NOT crm_security.business_can_write(k,target) THEN RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;\n IF token IS NULL OR (k='deal' AND r->>'version' IS DISTINCT FROM token) OR (k='inquiry' AND (r->>'updated_at')::timestamptz IS DISTINCT FROM token::timestamptz) THEN RAISE EXCEPTION 'version conflict' USING ERRCODE='PT409'; END IF;\n RETURN r;\nEND $function$\n",
      "volatility": "v",
      "security_definer": true
    },
    {
      "acl": [
        "postgres=X/postgres"
      ],
      "owner": "postgres",
      "config": [
        "search_path=\"\""
      ],
      "strict": false,
      "language": "plpgsql",
      "parallel": "u",
      "leakproof": false,
      "signature": "crm_security.business_log(text,uuid,text,jsonb,jsonb,text)",
      "definition": "CREATE OR REPLACE FUNCTION crm_security.business_log(k text, target uuid, act text, before_row jsonb, after_row jsonb, why text)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nDECLARE a record; eid uuid; BEGIN\n SELECT * INTO a FROM crm_security.actor(); IF NOT FOUND THEN RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;\n IF why IS NULL OR length(trim(why))<2 OR length(why)>2000 THEN RAISE EXCEPTION 'reason required' USING ERRCODE='22023'; END IF;\n INSERT INTO crm_security.business_events(entity_kind,object_id,action,actor_auth_uid,actor_user_id,actor_name,before_data,after_data,reason)\n VALUES(k,target,act,a.auth_uid,a.user_id,a.display_name,before_row,after_row,why) RETURNING id INTO eid;\n RETURN eid;\nEND $function$\n",
      "volatility": "v",
      "security_definer": true
    },
