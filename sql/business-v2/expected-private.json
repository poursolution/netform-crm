      "leakproof": false,
      "signature": "crm_security.can_deal(uuid,boolean)",
      "definition": "CREATE OR REPLACE FUNCTION crm_security.can_deal(target uuid, writing boolean DEFAULT false)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n SELECT EXISTS(SELECT 1 FROM crm_security.actor() a JOIN public.deals d ON d.id=target\n WHERE (a.permission_role='rep' AND d.owner_id=a.user_id)\n OR (a.permission_role IN('branch','admin') AND EXISTS(SELECT 1 FROM crm_security.object_scope s\n WHERE s.user_id=a.user_id AND s.deal_id=d.id AND s.expires_at>now() AND (NOT writing OR s.can_write))))\n$function$\n",
      "volatility": "s",
      "security_definer": true
    },
    {
      "acl": [
        "postgres=X/postgres"
      ],
      "owner": "postgres",
      "config": [
        "search_path=\"\""
      ],
      "strict": false,
      "language": "sql",
      "parallel": "u",
      "leakproof": false,
      "signature": "crm_security.can_inquiry(uuid)",
      "definition": "CREATE OR REPLACE FUNCTION crm_security.can_inquiry(target uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n SELECT EXISTS(SELECT 1 FROM crm_security.actor() a JOIN public.inquiries i ON i.id=target\n WHERE (a.permission_role IN('rep','consultation') AND i.assigned_to=a.user_id)\n OR (a.permission_role IN('branch','admin') AND EXISTS(SELECT 1 FROM crm_security.object_scope s\n WHERE s.user_id=a.user_id AND s.inquiry_id=i.id AND s.expires_at>now())))\n$function$\n",
      "volatility": "s",
      "security_definer": true
    }
